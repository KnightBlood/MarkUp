# hutch devkit sysroot + generated state (regenerated by `hutch electrobun sync`)
.hutch/
# cottontail hook/build staging (regenerated on every `hutch electrobun build`)
.cottontail-tmp/
# electrobun build output (buildFolder) and release artifacts (artifactFolder);
# archives are local-only, same policy as the root `artifacts/`
dist/
out/
artifacts/
