{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markup",
  "version": "0.1.0",
  "identifier": "dev.markup.editor",
  "build": {
    "beforeDevCommand": "cd frontend && corepack pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd frontend && corepack pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markup",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}