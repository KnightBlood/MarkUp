# `wails3 build` / `wails3 task package` output (binary, .app bundle, installers).
bin/
# Wails generates the whole platform scaffolding (Taskfiles, Info.plist,
# nsis/project.nsi, icons, nfpm config, …) from `build/config.yml` via
# `wails3 update build-assets`; only the inputs are checked in.
build/*
!build/config.yml
!build/appicon.png
# `wails3 generate bindings` output — this shell talks to Go through
# `Call.ByName` FQNs, so the bindings are not imported, just emitted.
frontend/bindings/
